#!/bin/bash

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^lib/.*\.dart$')

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "🔍 Running pre-commit hooks on staged files in lib/..."

echo "🎨 Formatting code with FVM..."
echo "$STAGED_FILES" | xargs fvm dart format
if [ $? -ne 0 ]; then
  echo "❌ Format failed!"
  exit 1
fi

echo "🛠️ Applying dart fixes with FVM..."
fvm dart fix --apply lib/
if [ $? -ne 0 ]; then
  echo "❌ Fix failed!"
  exit 1
fi

echo "$STAGED_FILES" | xargs git add

UNSTAGED_DART_FILES=$(git diff --name-only | grep '^lib/.*\.dart$')

if [ -n "$UNSTAGED_DART_FILES" ]; then
  echo "🧹 Reverting unstaged changes outside of current commit..."
  echo "$UNSTAGED_DART_FILES" | xargs git checkout --
fi

echo "✅ Pre-commit checks passed!"
exit 0